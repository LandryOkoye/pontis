# End-to-end run (tests/e2e). Defaults need nothing: it starts its own sandbox.
# E2E_MODE=sandbox            # or testnet, which uses the deployment below and skips the suspension step
# DATABASE_URL=postgres://pontis:pontis@localhost:5432/pontis   # the Postgres that hosts the throwaway database
# E2E_API_PORT=3099
#
# Testnet mode only: the deployer, and the key of the quote signer the contract already trusts
# DEPLOYER_ACCOUNT_ID=
# DEPLOYER_PRIVATE_KEY=
# QUOTE_SIGNER_SECRET_KEY=
