{
  "name": "@pontis/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Testnet deploy, seed and allowlist tooling for the Pontis contracts",
  "license": "MIT",
  "scripts": {
    "deploy-testnet": "tsx --env-file-if-exists=.env deploy-testnet.ts",
    "seed": "tsx --env-file-if-exists=.env seed-testnet.ts",
    "allowlist": "tsx --env-file-if-exists=.env allowlist.ts",
    "ops": "tsx --env-file-if-exists=.env ops.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "guards": "tsx --env-file-if-exists=.env guards.ts",
    "actions": "tsx --env-file-if-exists=.env actions.ts"
  },
  "dependencies": {
    "@pontis/dev-keys": "workspace:*",
    "@pontis/domain": "workspace:*",
    "@pontis/market-data": "workspace:*",
    "@pontis/near-client": "workspace:*",
    "@pontis/quote-engine": "workspace:*",
    "near-api-js": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
