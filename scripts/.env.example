# Deploy, seed and allowlist tooling (scripts/). Copy to scripts/.env. Never commit .env.
# TESTNET ONLY: any other network is refused.
NEAR_NETWORK_ID=testnet
# rpc.testnet.near.org is deprecated and answers 429; see docs/local-setup.md (RPC endpoints)
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Funded testnet account that owns every contract and holds every role.
DEPLOYER_ACCOUNT_ID=
# ed25519:<secret key>. If empty, ~/.near-credentials/testnet/<account>.json is used.
DEPLOYER_PRIVATE_KEY=

# Defaults are pontis-core.<deployer>, tgold-a.<deployer>, tgold-b.<deployer>.
PONTIS_CORE_ACCOUNT_ID=
TGOLD_A_ACCOUNT_ID=
TGOLD_B_ACCOUNT_ID=

# Quote signer. Leave empty to generate one on first seed; the key is printed once.
QUOTE_SIGNER_SECRET_KEY=
# Comma-separated accounts to allowlist on both representations during seed.
ALLOWLIST_ACCOUNTS=

# Reserves and redemption simulators (docs/runbooks/reserves-and-redemption.md). SIMULATED, dev keys,
# testnet and sandbox only.
# Account that relays submit_reserve_attestation (the signature is the authority). Empty: the deployer.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Simulated issuer back-office: an account listed in the issuer's controlled_accounts. The key is
# BACKOFFICE_PRIVATE_KEY, else its NEAR credentials file, else the public dev issuer-backoffice key
# (add that key to the account first).
BACKOFFICE_ACCOUNT_ID=
BACKOFFICE_PRIVATE_KEY=
# Optional, comma-separated issuer ids the back-office serves (default: every redeemable representation).
BACKOFFICE_ISSUER_IDS=
# Optional path of the simulated cover ratios written by `reserves drift` (default scripts/.reserves-state.json).
RESERVES_STATE_FILE=
