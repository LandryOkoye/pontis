# Pontis market simulator (apps/simulator). Copy to .env. Everything it writes is flagged simulated.

# Same database as the API and the indexer
DATABASE_URL=postgres://pontis:pontis@localhost:5432/pontis

# How far back `backfill` writes prices (days), and the pause between `run` ticks (ms)
SIM_BACKFILL_DAYS=90
SIM_TICK_MS=10000
