# Pontis indexer (apps/indexer). Copy to .env. Never commit .env.
NODE_ENV=development

DATABASE_URL=postgres://pontis:pontis@localhost:5432/pontis

# NEAR Testnet
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Deployed contract account to index (filled in by B8)
PONTIS_CORE_ACCOUNT_ID=

# Polling and finality handling (B12)
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_FINALITY_WINDOW_BLOCKS=10
# Block height to start from on first run; empty = current head
INDEXER_START_BLOCK=
