# Pontis indexer (apps/indexer). Copy to .env. Never commit .env.

# Local docker-compose Postgres (see docker-compose.yml); same database as the API
DATABASE_URL=postgres://pontis:pontis@localhost:5432/pontis

# NEAR Testnet. The node must support EXPERIMENTAL_light_client_proof.
NEAR_RPC_URL=https://rpc.testnet.near.org

# The deployed core contract (see docs/architecture/deployments.md)
PONTIS_CORE_ACCOUNT_ID=

# First block to read when there is no cursor yet; empty means the current chain head.
# Set it to the deployment block to backfill the history of a fresh database.
INDEXER_START_HEIGHT=

# Pause between passes once caught up (ms)
INDEXER_POLL_MS=2000

# Blocks read again behind the cursor on start
INDEXER_RESCAN_BLOCKS=30

# Parallel chunk reads (only matters when the shard layout is unknown)
INDEXER_CHUNK_CONCURRENCY=4
