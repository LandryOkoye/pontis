{
  "name": "@pontis/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pontis NEAR event indexer: reads pontis-core receipts and settles conversions in Postgres",
  "license": "MIT",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/main.ts",
