    "@pontis/near-client": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
