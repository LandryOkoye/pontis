# Pontis web (apps/web). Copy to .env.local. Never commit real keys.

# mock: the app runs entirely on MSW fixtures with a simulated wallet (no chain, no API).
# live: the app talks to the Pontis API and a real NEAR Testnet wallet.
VITE_API_MODE=mock

# Base URL of the Pontis API in live mode (its CORS_ORIGIN must include this app's origin).
VITE_API_URL=http://localhost:3000

# NEAR Testnet RPC for balance and faucet views. rpc.testnet.near.org is deprecated.
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com

# Ethereum Sepolia RPC for lending reads (token decimals and balances). Never used to sign.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployed contracts (docs/architecture/deployment-record.md).
VITE_PONTIS_CORE_ACCOUNT_ID=pontis-core.pontis.testnet
