{
  "name": "@pontis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pontis REST API (Fastify): catalog, quotes and conversions on NEAR Testnet",
  "license": "MIT",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "sync": "tsx --env-file-if-exists=.env src/sync/sync-once.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@pontis/api-types": "workspace:*",
    "@pontis/db": "workspace:*",
    "@pontis/domain": "workspace:*",
    "@pontis/market-data": "workspace:*",
    "@pontis/near-client": "workspace:*",
    "@pontis/quote-engine": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
