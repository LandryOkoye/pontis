# Pontis API (apps/api). Copy to .env. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Local docker-compose Postgres (see docker-compose.yml)
DATABASE_URL=postgres://pontis:pontis@localhost:5432/pontis

# NEAR Testnet
NEAR_NETWORK_ID=testnet
# NEAR_RPC_URL is required (no default). The API refuses to start if the node's chain does not
# match NEAR_NETWORK_ID.
# rpc.testnet.near.org is deprecated and answers 429; see docs/local-setup.md (RPC endpoints)
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Deployed contract accounts (filled in by B8, see docs/architecture/deployments.md)
PONTIS_CORE_ACCOUNT_ID=
TGOLD_A_ACCOUNT_ID=
TGOLD_B_ACCOUNT_ID=

# Quote-signer ed25519 key. TESTNET ONLY. Lives in env, never in git.
# Format: ed25519:<base58 secret key>
QUOTE_SIGNER_SECRET_KEY=

# Background registry sync from the chain into Postgres (ms; 0 disables, use `pnpm sync`)
REGISTRY_SYNC_INTERVAL_MS=15000

# Health: indexer heartbeat older than this is "stale" (ms, at least 1000); keep it well above
# the indexer's INDEXER_POLL_MS and its retry pauses
INDEXER_STALE_AFTER_MS=30000
# Health: a fresh indexer more than this many blocks behind the chain is "lagging"
INDEXER_MAX_LAG_BLOCKS=50

# How often unused quotes past their 60 s expiry are marked EXPIRED (ms, at least 1000)
QUOTE_SWEEP_INTERVAL_MS=10000

# Break-glass bearer key for /v1/admin/* and /metrics (at least 16 characters; empty turns it off).
# Audited as `legacy-admin-key`. Operators normally sign in with a wallet (docs/runbooks/auth.md).
ADMIN_API_KEY=

# The NEP-413 `recipient` wallets are told a sign-in is for. Default: pontis-api.<NEAR_NETWORK_ID>
AUTH_RECIPIENT=

# Browser origins allowed by CORS, comma-separated, exact origins only (no wildcard)
CORS_ORIGIN=http://localhost:5173

# Rate limits per client and window, by class; behind a reverse proxy set TRUST_PROXY=true
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=30
RATE_LIMIT_ADMIN=10
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false

# Serve the example data from @pontis/api-types instead of the chain, so the frontend can build
# screens with no node, database or signer. Responses carry `x-pontis-mode: fixtures`. Needs only
# HOST, PORT and CORS_ORIGIN; every other variable above is ignored in this mode.
# API_MODE=fixtures

# Optional EVM lending integration. Leave every value blank until the controlled
# Sepolia deployment has been verified (see docs/morpho-sepolia-lending.md).
# Pontis never ships a guessed Morpho, oracle, RWA, or stablecoin address.
MORPHO_SEPOLIA_RPC_URL=
MORPHO_BLUE_ADDRESS=
# JSON array of { id, collateralAssetId, collateralToken, loanToken, loanSymbol, oracle, irm, lltvWad }
MORPHO_BLUE_MARKETS_JSON=
# JSON registry/policy and a freshness-aware controlled price source are required
# before enabling lending routes in a deployment.
PONTIS_COLLATERAL_REGISTRY_JSON=
PONTIS_ORACLE_PRICES_JSON=
