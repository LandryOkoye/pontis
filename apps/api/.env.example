# Pontis API (apps/api). Copy to .env. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Local docker-compose Postgres (see docker-compose.yml)
DATABASE_URL=postgres://pontis:pontis@localhost:5432/pontis

# NEAR Testnet
NEAR_NETWORK_ID=testnet
# NEAR_RPC_URL is required (no default). The API refuses to start if the node's chain does not
# match NEAR_NETWORK_ID.
# rpc.testnet.near.org is deprecated and answers 429; see docs/local-setup.md (RPC endpoints)
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Deployed contract accounts (filled in by B8, see docs/architecture/deployments.md)
PONTIS_CORE_ACCOUNT_ID=
TGOLD_A_ACCOUNT_ID=
TGOLD_B_ACCOUNT_ID=

# Quote-signer ed25519 key. TESTNET ONLY. Lives in env, never in git.
# Format: ed25519:<base58 secret key>
QUOTE_SIGNER_SECRET_KEY=

# Background registry sync from the chain into Postgres (ms; 0 disables, use `pnpm sync`)
REGISTRY_SYNC_INTERVAL_MS=15000

# How often unused quotes past their 60 s expiry are marked EXPIRED (ms, at least 1000)
QUOTE_SWEEP_INTERVAL_MS=10000

# Bearer key for /v1/admin/* (at least 16 characters; empty closes the admin endpoints)
ADMIN_API_KEY=

# Browser origins allowed by CORS, comma-separated, exact origins only (no wildcard)
CORS_ORIGIN=http://localhost:5173

# Rate limits per client and window, by class; behind a reverse proxy set TRUST_PROXY=true
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=30
RATE_LIMIT_ADMIN=10
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false
